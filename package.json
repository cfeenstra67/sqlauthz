{
  "name": "sqlauthz",
  "type": "module",
  "version": "1.1.0",
  "description": "Declarative permission management for PostgreSQL",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "run-ts": "tsx",
    "cli": "tsx src/cli.ts",
    "test": "find ./test -name '*.test.ts' | xargs tsx --test",
    "check": "biome check --write src test",
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && chmod +x dist/cli.js && cp -r src/sql dist/sql",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "npm-publish": "scripts/publish.sh"
  },
  "bin": {
    "sqlauthz": "./dist/cli.js"
  },
  "keywords": [
    "postgresql",
    "oso",
    "rbac",
    "pg",
    "permission",
    "declarative"
  ],
  "homepage": "https://github.com/cfeenstra67/sqlauthz",
  "bugs": {
    "url": "https://github.com/cfeenstra67/sqlauthz/issues"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE.txt",
    "src",
    "dist"
  ],
  "author": "cameron.l.feenstra@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/cfeenstra67/sqlauthz"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "fdir": "^6.5.0",
    "oso": "^0.27.3",
    "pg": "^8.23.0",
    "picomatch": "^3.0.2",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
